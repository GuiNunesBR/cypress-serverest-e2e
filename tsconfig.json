{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["cypress", "node", "cypress-mochawesome-reporter"]
  },
  "include": ["cypress/**/*.ts", "unit/**/*.ts", "cypress.config.ts"]
}
